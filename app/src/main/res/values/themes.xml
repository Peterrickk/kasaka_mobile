<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Kasaka" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ks_bg</item>
    </style>

    <style name="Theme.Kasaka.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ks_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/white</item>
        <item name="postSplashScreenTheme">@style/Theme.Kasaka</item>
    </style>
</resources>
